#!/bin/sh
#
# Commit-msg hook для live-hints
# Проверяет формат сообщения коммита
#

commit_msg_file=$1
commit_msg=$(head -n1 "$commit_msg_file")

# Проверка на пустое сообщение
if [ -z "$commit_msg" ]; then
    echo "❌ Сообщение коммита не может быть пустым"
    exit 1
fi

# Проверка длины сообщения (максимум 72 символа для первой строки)
if [ ${#commit_msg} -gt 72 ]; then
    echo "⚠️  Предупреждение: первая строка сообщения длиннее 72 символов"
fi

# Проверка на запрещённые префиксы (conventional commits)
# Правила проекта требуют русский язык без префиксов: «Доработал…», «Исправил…» и т.д.
forbidden_types="feat|fix|docs|style|refactor|test|chore|perf|ci|build|merge|wip"
if echo "$commit_msg" | grep -qiE "^($forbidden_types)(\([^)]+\))?:"; then
    echo "❌ Ошибка: правила проекта запрещают префиксы коммитов (feat:, fix: и т.д.)."
    echo "   Сообщение должно начинаться с глагола совершенного вида на русском (например: «Исправил...», «Доработал...»)."
    exit 1
fi

echo "✓ Сообщение коммита прошло проверку"
exit 0
